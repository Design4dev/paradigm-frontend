# Copy to .env.local and fill in for your environment. Every var is read
# through src/config/environment.ts — nothing else touches process.env directly.

# Public site URL, used for metadata/canonical links and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gate for the prototype /admin section (middleware.ts). Unset = /admin is
# closed. Set a value here, then visit /admin?key=<value> once per browser.
ADMIN_ACCESS_KEY=

# Shared secret inbound requests to /api/webhooks must send via the
# `x-webhook-secret` header. Unset = the endpoint rejects everything.
WEBHOOK_SECRET=

# Optional — without these, services/salesforce runs in logged "mock mode"
# and /api/leads still works end-to-end.
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=

# Optional — without this, features/analytics no-ops (logs in dev only).
NEXT_PUBLIC_ANALYTICS_ID=

# Apprentall booking-engine base URL + client ID. Both are public/non-secret
# — they're the exact values paradigmtruckrental.com itself embeds
# (verified from that site's production HTML: <iframe id="reservation_iframe"
# src="https://book.apprentall.cloud/?clientid=1923">). Prefilled so local
# dev matches production out of the box; override only for a different
# client/location. If either is cleared, the rental Book Now section falls
# back to an honest "booking connection unavailable" state instead of a
# broken/fabricated embed.
NEXT_PUBLIC_APPRENTALL_URL=https://book.apprentall.cloud
NEXT_PUBLIC_APPRENTALL_CLIENT_ID=1923
